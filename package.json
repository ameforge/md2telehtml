{
  "name": "md2telehtml",
  "version": "0.1.0",
  "description": "Convert Markdown to Telegram HTML, split into messages that fit.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./index.d.ts",
  "files": [
    "dist",
    "index.d.ts"
  ],
  "scripts": {
    "build": "rsbuild build",
    "lint": "biome migrate --write && biome check --write",
    "prepare": "pnpm build",
    "test": "node --test"
  },
  "keywords": [
    "telegram",
    "markdown",
    "html",
    "grammy",
    "bot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ameforge/md2telehtml.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@rsbuild/core": "^2.3.3"
  }
}
